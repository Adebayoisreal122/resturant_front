# Your restaurant API (the Node backend), including /api
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Where Socket.IO lives (same server, without /api)
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
# Shown in the header, titles and when the app is installed
NEXT_PUBLIC_APP_NAME=Naija Kitchen
# Must match the backend VAT settings (used only for the price estimate; the server is the final authority)
NEXT_PUBLIC_VAT_RATE=0.075
NEXT_PUBLIC_VAT_MODE=exclusive
