{
  "name": "restaurant-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:contract:build": "esbuild tests/contract-entry.ts --bundle --platform=node --format=esm --outfile=tests/.build/contract.mjs --define:process.env.NEXT_PUBLIC_API_URL=\\\"$API_URL\\\" --log-level=warning",
    "test:contract": "npm run test:contract:build && node tests/admin-contract.mjs",
    "test:contract:pos": "npm run test:contract:build && node tests/pos-contract.mjs",
    "test:live": "node tests/pos-live.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.63.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}